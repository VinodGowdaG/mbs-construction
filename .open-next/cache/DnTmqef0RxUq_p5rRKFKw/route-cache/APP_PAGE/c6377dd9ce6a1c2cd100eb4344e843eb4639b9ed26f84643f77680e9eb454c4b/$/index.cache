object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fcivil.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent\"></div><span class=\"absolute left-6 top-6 rounded-full bg-[#D62828] px-4 py-2 text-lg font-bold text-white\">03</span></div><div class=\"p-7\"><h3 class=\"text-2xl font-bold text-[#D62828]\">Civil Construction</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Industrial, commercial and infrastructure civil construction with quality workmanship.</p><a class=\"mt-6 inline-flex items-center gap-2 font-semibold text-[#D62828] transition group-hover:gap-3\" href=\"/services/civil-construction\">Learn More<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div class=\"group overflow-hidden rounded-3xl bg-white shadow-lg transition hover:shadow-2xl\"><div class=\"relative h-64 overflow-hidden\"><img alt=\"Roofing Solutions\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Froofing.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent\"></div><span class=\"absolute left-6 top-6 rounded-full bg-[#D62828] px-4 py-2 text-lg font-bold text-white\">04</span></div><div class=\"p-7\"><h3 class=\"text-2xl font-bold text-[#D62828]\">Roofing Solutions</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Complete roofing systems including PUF Panels, UPVC Sheets, Turbo Ventilators and accessories.</p><a class=\"mt-6 inline-flex items-center gap-2 font-semibold text-[#D62828] transition group-hover:gap-3\" href=\"/services/roofing-solutions\">Learn More<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div class=\"group overflow-hidden rounded-3xl bg-white shadow-lg transition hover:shadow-2xl\"><div class=\"relative h-64 overflow-hidden\"><img alt=\"Steel Fabrication\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Ffabrication.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent\"></div><span class=\"absolute left-6 top-6 rounded-full bg-[#D62828] px-4 py-2 text-lg font-bold text-white\">05</span></div><div class=\"p-7\"><h3 class=\"text-2xl font-bold text-[#D62828]\">Steel Fabrication</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Precision steel fabrication for industrial buildings, structures and custom projects.</p><a class=\"mt-6 inline-flex items-center gap-2 font-semibold text-[#D62828] transition group-hover:gap-3\" href=\"/services/steel-fabrication\">Learn More<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div><div class=\"group overflow-hidden rounded-3xl bg-white shadow-lg transition hover:shadow-2xl\"><div class=\"relative h-64 overflow-hidden\"><img alt=\"Turnkey Projects\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fturnkey.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent\"></div><span class=\"absolute left-6 top-6 rounded-full bg-[#D62828] px-4 py-2 text-lg font-bold text-white\">06</span></div><div class=\"p-7\"><h3 class=\"text-2xl font-bold text-[#D62828]\">Turnkey Projects</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">From planning and design to execution and handover, we deliver complete turnkey solutions.</p><a class=\"mt-6 inline-flex items-center gap-2 font-semibold text-[#D62828] transition group-hover:gap-3\" href=\"/services/turnkey-projects\">Learn More<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></div></section><section id=\"why-choose\" class=\"bg-slate-50 py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"mx-auto mb-16 max-w-3xl text-center\" style=\"opacity:0;transform:translateY(40px)\"><span class=\"rounded-full bg-[#D62828]/10 px-5 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-[#D62828]\">Why Choose MBS</span><h2 class=\"mt-6 text-5xl font-bold text-[#D62828]\">Building Trust Through Quality &amp; Excellence</h2><p class=\"mt-6 text-lg leading-8 text-[#0B4EA2]\">We combine engineering expertise, premium materials, and timely execution to deliver industrial projects that stand the test of time.</p></div><div class=\"grid items-center gap-16 lg:grid-cols-2\"><div class=\"grid gap-6 sm:grid-cols-2\"><div class=\"group rounded-3xl border border-slate-200 bg-white p-7 shadow-md transition hover:border-[#D62828] hover:shadow-2xl\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hard-hat h-8 w-8 text-[#0B4EA2] group-hover:text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5\"></path><path d=\"M14 6a6 6 0 0 1 6 6v3\"></path><path d=\"M4 15v-3a6 6 0 0 1 6-6\"></path><rect x=\"2\" y=\"15\" width=\"20\" height=\"4\" rx=\"1\"></rect></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Experienced Engineers</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Our experienced engineering team delivers every project with precision, safety and technical excellence.</p></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-7 shadow-md transition hover:border-[#D62828] hover:shadow-2xl\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 h-8 w-8 text-[#0B4EA2] group-hover:text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Complete Turnkey Solutions</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">From design and planning to execution and handover, we handle every stage of construction.</p></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-7 shadow-md transition hover:border-[#D62828] hover:shadow-2xl\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-8 w-8 text-[#0B4EA2] group-hover:text-[#D62828]\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Premium Quality</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">We use certified materials and proven construction practices for long-lasting structures.</p></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-7 shadow-md transition hover:border-[#D62828] hover:shadow-2xl\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock3 lucide-clock-3 h-8 w-8 text-[#0B4EA2] group-hover:text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6h4\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">On-Time Delivery</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Efficient planning and execution ensure timely completion without compromising quality.</p></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-7 shadow-md transition hover:border-[#D62828] hover:shadow-2xl\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award h-8 w-8 text-[#0B4EA2] group-hover:text-[#D62828]\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Trusted Industry Partner</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Our commitment to excellence has earned the trust of industrial and commercial clients.</p></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-7 shadow-md transition hover:border-[#D62828] hover:shadow-2xl\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-8 w-8 text-[#0B4EA2] group-hover:text-[#D62828]\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Customer First</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Every project is executed with transparency, communication and customer satisfaction as our priority.</p></div></div><div class=\"relative\" style=\"opacity:0;transform:translateX(80px)\"><img alt=\"MBS Construction Team\" loading=\"lazy\" width=\"700\" height=\"700\" decoding=\"async\" data-nimg=\"1\" class=\"rounded-3xl shadow-2xl\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Fwhy-choose%2Fteam.png&amp;w=750&amp;q=75 1x, /_next/image?url=%2Fimages%2Fwhy-choose%2Fteam.png&amp;w=1920&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Fwhy-choose%2Fteam.png&amp;w=1920&amp;q=75\"/><div class=\"absolute bottom-6 left-6 right-6 grid grid-cols-2 gap-4\"><div class=\"rounded-2xl bg-white p-8 text-center shadow-md transition hover:shadow-2xl\"><h3 class=\"text-5xl font-extrabold text-[#D62828]\">+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Years Experience</p></div><div class=\"rounded-2xl bg-white p-8 text-center shadow-md transition hover:shadow-2xl\"><h3 class=\"text-5xl font-extrabold text-[#D62828]\">+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Projects Completed</p></div><div class=\"rounded-2xl bg-white p-8 text-center shadow-md transition hover:shadow-2xl\"><h3 class=\"text-5xl font-extrabold text-[#D62828]\">+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Happy Clients</p></div><div class=\"rounded-2xl bg-white p-8 text-center shadow-md transition hover:shadow-2xl\"><h3 class=\"text-5xl font-extrabold text-[#D62828]\">/7</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Customer Support</p></div></div></div></div></div></section><section class=\"bg-white py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"mx-auto mb-16 max-w-3xl text-center\" style=\"opacity:0;transform:translateY(40px)\"><span class=\"rounded-full bg-[#D62828]/10 px-5 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-[#D62828]\">Our Process</span><h2 class=\"mt-6 text-5xl font-bold text-[#D62828]\">How We Build Your Project</h2><p class=\"mt-6 text-lg leading-8 text-[#0B4EA2]\">Every project follows a structured process that ensures quality, safety, transparency and timely delivery.</p></div><div class=\"grid gap-8 md:grid-cols-2 xl:grid-cols-3\"><div class=\"relative rounded-3xl border border-slate-200 bg-white p-8 shadow-lg hover:shadow-2xl\"><span class=\"absolute right-6 top-6 text-5xl font-extrabold text-[#D62828]/10\">01</span><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-circle h-8 w-8 text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Consultation</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">We understand your project requirements, budget and timeline before planning begins.</p></div><div class=\"relative rounded-3xl border border-slate-200 bg-white p-8 shadow-lg hover:shadow-2xl\"><span class=\"absolute right-6 top-6 text-5xl font-extrabold text-[#D62828]/10\">02</span><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-pencil-ruler h-8 w-8 text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"M13 7 8.7 2.7a2.41 2.41 0 0 0-3.4 0L2.7 5.3a2.41 2.41 0 0 0 0 3.4L7 13\"></path><path d=\"m8 6 2-2\"></path><path d=\"m18 16 2-2\"></path><path d=\"m17 11 4.3 4.3c.94.94.94 2.46 0 3.4l-2.6 2.6c-.94.94-2.46.94-3.4 0L11 17\"></path><path d=\"M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z\"></path><path d=\"m15 5 4 4\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Planning &amp; Design</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Our engineers prepare optimized layouts, structural designs and project schedules.</p></div><div class=\"relative rounded-3xl border border-slate-200 bg-white p-8 shadow-lg hover:shadow-2xl\"><span class=\"absolute right-6 top-6 text-5xl font-extrabold text-[#D62828]/10\">03</span><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-factory h-8 w-8 text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"M12 16h.01\"></path><path d=\"M16 16h.01\"></path><path d=\"M3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5a.5.5 0 0 0-.769-.422l-4.462 2.844A.5.5 0 0 1 15 10.5v-2a.5.5 0 0 0-.769-.422L9.77 10.922A.5.5 0 0 1 9 10.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z\"></path><path d=\"M8 16h.01\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Engineering &amp; Fabrication</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Precision fabrication using quality steel and advanced manufacturing practices.</p></div><div class=\"relative rounded-3xl border border-slate-200 bg-white p-8 shadow-lg hover:shadow-2xl\"><span class=\"absolute right-6 top-6 text-5xl font-extrabold text-[#D62828]/10\">04</span><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hammer h-8 w-8 text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9\"></path><path d=\"m18 15 4-4\"></path><path d=\"m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Construction &amp; Installation</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Experienced teams execute the project with strict quality and safety standards.</p></div><div class=\"relative rounded-3xl border border-slate-200 bg-white p-8 shadow-lg hover:shadow-2xl\"><span class=\"absolute right-6 top-6 text-5xl font-extrabold text-[#D62828]/10\">05</span><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-8 w-8 text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Quality Inspection</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">Every stage is inspected to ensure structural integrity and premium workmanship.</p></div><div class=\"relative rounded-3xl border border-slate-200 bg-white p-8 shadow-lg hover:shadow-2xl\"><span class=\"absolute right-6 top-6 text-5xl font-extrabold text-[#D62828]/10\">06</span><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-key-round h-8 w-8 text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z\"></path><circle cx=\"16.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg></div><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Project Handover</h3><p class=\"mt-4 leading-7 text-[#0B4EA2]\">After successful completion and inspection, the project is handed over on time.</p></div></div></div></section><section class=\"bg-slate-50 py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"mx-auto mb-16 max-w-3xl text-center\" style=\"opacity:0;transform:translateY(40px)\"><span class=\"rounded-full bg-[#D62828]/10 px-5 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-[#D62828]\">Industries We Serve</span><h2 class=\"mt-6 text-5xl font-bold text-[#D62828]\">Building Across Diverse Industries</h2><p class=\"mt-6 text-lg leading-8 text-[#0B4EA2]\">From industrial warehouses to commercial buildings, MBS Construction delivers reliable, high-quality infrastructure tailored to every industry&#x27;s unique requirements.</p></div><div class=\"grid gap-8 md:grid-cols-2 xl:grid-cols-3\"><div class=\"group relative overflow-hidden rounded-3xl\"><div class=\"relative h-80\"><img alt=\"Industrial Warehouses\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=