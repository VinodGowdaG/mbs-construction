images%2Fabout%2Fabout-hero.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fabout%2Fabout-hero.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-r from-[#0B4EA2]/90 via-[#0B4EA2]/75 to-black/70\"></div><div class=\"absolute left-0 top-0 h-96 w-96 rounded-full bg-[#D62828]/20 blur-[140px]\"></div><div class=\"absolute bottom-0 right-0 h-96 w-96 rounded-full bg-blue-500/20 blur-[140px]\"></div><div class=\"relative z-10 mx-auto flex h-full max-w-7xl items-center px-6\"><div class=\"max-w-4xl\"><span class=\"inline-flex rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-semibold uppercase tracking-[0.25em] text-white backdrop-blur-md\" style=\"opacity:0;transform:translateY(25px)\">About MBS Construction</span><h1 class=\"mt-8 text-5xl font-extrabold leading-tight text-white md:text-7xl\" style=\"opacity:0;transform:translateY(35px)\">Building Tomorrow&#x27;s Industrial Infrastructure</h1><p class=\"mt-8 max-w-3xl text-lg leading-8 text-white/90 md:text-xl\" style=\"opacity:0;transform:translateY(35px)\">MBS Construction is a trusted name in Pre-Engineered Buildings, Warehouse Construction, Civil Construction, Roofing Solutions, Steel Fabrication and Turnkey Industrial Projects across Karnataka.</p><div class=\"mt-12 flex flex-wrap gap-5\" style=\"opacity:0;transform:translateY(35px)\"><a class=\"inline-flex items-center gap-2 rounded-full bg-[#D62828] px-8 py-4 font-semibold text-white transition hover:scale-105 hover:bg-red-700\" href=\"/projects\">View Projects<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-8 py-4 font-semibold text-white backdrop-blur-md transition hover:bg-white hover:text-[#0B4EA2]\" href=\"/contact\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-phone\" aria-hidden=\"true\"><path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"></path></svg>Contact Us</a></div></div></div></div><div class=\"relative -mt-20 z-20 mx-auto grid max-w-7xl gap-6 px-6 md:grid-cols-4\"><div class=\"rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-xl\" style=\"opacity:0;transform:translateY(35px)\"><h3 class=\"text-4xl font-bold text-[#D62828]\">10+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Years Experience</p></div><div class=\"rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-xl\" style=\"opacity:0;transform:translateY(35px)\"><h3 class=\"text-4xl font-bold text-[#D62828]\">250+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Projects Completed</p></div><div class=\"rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-xl\" style=\"opacity:0;transform:translateY(35px)\"><h3 class=\"text-4xl font-bold text-[#D62828]\">120+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Happy Clients</p></div><div class=\"rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-xl\" style=\"opacity:0;transform:translateY(35px)\"><h3 class=\"text-4xl font-bold text-[#D62828]\">40+</h3><p class=\"mt-3 font-medium text-[#0B4EA2]\">Expert Engineers</p></div></div></section><section class=\"bg-white py-24\"><div class=\"mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-2\"><div class=\"relative\" style=\"opacity:0;transform:translateX(-60px)\"><div class=\"relative overflow-hidden rounded-[32px] shadow-2xl\"><img alt=\"Our Story\" loading=\"lazy\" width=\"700\" height=\"650\" decoding=\"async\" data-nimg=\"1\" class=\"h-[620px] w-full object-cover transition duration-700 hover:scale-105\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Fabout%2Fcompany-story.png&amp;w=750&amp;q=75 1x, /_next/image?url=%2Fimages%2Fabout%2Fcompany-story.png&amp;w=1920&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Fabout%2Fcompany-story.png&amp;w=1920&amp;q=75\"/></div><div class=\"absolute -bottom-8 -right-8 rounded-3xl bg-[#D62828] p-8 text-white shadow-2xl\"><h3 class=\"text-4xl font-bold\">10+</h3><p class=\"mt-2 text-sm uppercase tracking-widest\">Years of Experience</p></div></div><div style=\"opacity:0;transform:translateX(60px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Our Story</span><h2 class=\"mt-5 text-5xl font-bold leading-tight text-[#D62828]\">Engineering Excellence<br/>Since Day One</h2><div class=\"mt-8 space-y-6\"><p class=\"text-lg leading-8 text-slate-600\">MBS Construction was established with a vision to provide high-quality industrial construction solutions backed by engineering excellence and customer satisfaction.</p><p class=\"text-lg leading-8 text-slate-600\">Over the years, we have successfully completed warehouses, factory buildings, industrial sheds, commercial buildings and turnkey infrastructure projects for clients across Karnataka.</p><p class=\"text-lg leading-8 text-slate-600\">Our experienced engineers, skilled workforce and modern construction techniques enable us to deliver projects with superior quality, on-time execution and long-lasting performance.</p></div><div class=\"mt-10 grid gap-5\"><div class=\"flex items-center gap-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"text-lg font-medium text-[#0B4EA2]\">Premium Construction Quality</span></div><div class=\"flex items-center gap-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"text-lg font-medium text-[#0B4EA2]\">Experienced Engineering Team</span></div><div class=\"flex items-center gap-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"text-lg font-medium text-[#0B4EA2]\">Modern Equipment &amp; Technology</span></div><div class=\"flex items-center gap-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span class=\"text-lg font-medium text-[#0B4EA2]\">On-Time Project Delivery</span></div></div><div class=\"mt-12 rounded-3xl border-l-4 border-[#D62828] bg-slate-50 p-8\"><p class=\"text-xl italic leading-8 text-slate-700\">&quot;At MBS Construction, every project is more than a structure— it&#x27;s a long-term partnership built on trust, quality, and engineering excellence.&quot;</p></div></div></div></section><section class=\"relative overflow-hidden bg-slate-50 py-24\"><div class=\"absolute left-0 top-0 h-72 w-72 rounded-full bg-[#0B4EA2]/10 blur-[120px]\"></div><div class=\"absolute bottom-0 right-0 h-72 w-72 rounded-full bg-[#D62828]/10 blur-[120px]\"></div><div class=\"relative mx-auto max-w-7xl px-6\"><div class=\"mb-16 text-center\" style=\"opacity:0;transform:translateY(35px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Company Statistics</span><h2 class=\"mt-5 text-5xl font-bold text-[#D62828]\">Numbers That Speak</h2><p class=\"mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600\">Every completed project reflects our commitment to quality, engineering excellence, and customer satisfaction.</p></div><div class=\"grid gap-8 md:grid-cols-2 xl:grid-cols-4\"><div class=\"rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-lg transition-all\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg></div><h3 class=\"mt-8 text-5xl font-bold text-[#D62828]\">+</h3><p class=\"mt-4 text-lg font-semibold text-[#0B4EA2]\">Years Experience</p></div><div class=\"rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-lg transition-all\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-briefcase-business text-[#D62828]\" aria-hidden=\"true\"><path d=\"M12 12h.01\"></path><path d=\"M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2\"></path><path d=\"M22 13a18.15 18.15 0 0 1-20 0\"></path><rect width=\"20\" height=\"14\" x=\"2\" y=\"6\" rx=\"2\"></rect></svg></div><h3 class=\"mt-8 text-5xl font-bold text-[#D62828]\">+</h3><p class=\"mt-4 text-lg font-semibold text-[#0B4EA2]\">Projects Completed</p></div><div class=\"rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-lg transition-all\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users text-[#D62828]\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"mt-8 text-5xl font-bold text-[#D62828]\">+</h3><p class=\"mt-4 text-lg font-semibold text-[#0B4EA2]\">Happy Clients</p></div><div class=\"rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-lg transition-all\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hard-hat text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5\"></path><path d=\"M14 6a6 6 0 0 1 6 6v3\"></path><path d=\"M4 15v-3a6 6 0 0 1 6-6\"></path><rect x=\"2\" y=\"15\" width=\"20\" height=\"4\" rx=\"1\"></rect></svg></div><h3 class=\"mt-8 text-5xl font-bold text-[#D62828]\">+</h3><p class=\"mt-4 text-lg font-semibold text-[#0B4EA2]\">Expert Engineers</p></div></div></div></section><section class=\"relative overflow-hidden bg-white py-24\"><div class=\"absolute left-0 top-0 h-80 w-80 rounded-full bg-[#0B4EA2]/10 blur-[120px]\"></div><div class=\"absolute bottom-0 right-0 h-80 w-80 rounded-full bg-[#D62828]/10 blur-[120px]\"></div><div class=\"relative mx-auto max-w-7xl px-6\"><div class=\"mb-16 text-center\" style=\"opacity:0;transform:translateY(35px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Our Purpose</span><h2 class=\"mt-5 text-5xl font-bold text-[#D62828]\">Mission &amp; Vision</h2><p class=\"mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600\">Guided by innovation, engineering excellence, and customer satisfaction, we strive to build lasting infrastructure that empowers industries and communities.</p></div><div class=\"grid gap-10 lg:grid-cols-2\"><div class=\"group rounded-[32px] border border-slate-200 bg-white p-10 shadow-xl transition-all\" style=\"opacity:0;transform:translateX(-40px)\"><div class=\"flex h-20 w-20 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-target text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle></svg></div><h3 class=\"mt-8 text-3xl font-bold text-[#D62828]\">Our Mission</h3><p class=\"mt-6 text-lg leading-8 text-slate-600\">To deliver world-class industrial infrastructure through innovation, engineering excellence, premium quality materials and customer-focused solutions.</p><div class=\"mt-8 h-1 w-24 rounded-full bg-[#D62828]\"></div></div><div class=\"group rounded-[32px] border border-slate-200 bg-white p-10 shadow-xl transition-all\" style=\"opacity:0;transform:translateX(40px)\"><div class=\"flex h-20 w-20 items-center justify-center rounded-2xl bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye text-[#0B4EA2]\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></div><h3 class=\"mt-8 text-3xl font-bold text-[#D62828]\">Our Vision</h3><p class=\"mt-6 text-lg leading-8 text-slate-600\">To become Karnataka&#x27;s most trusted construction company by delivering sustainable, innovative and reliable infrastructure projects.</p><div class=\"mt-8 h-1 w-24 rounded-full bg-[#0B4EA2]\"></div></div></div></div></section><section class=\"bg-slate-50 py-24\"><div class=\"mx-auto max-w-7xl px-6\"><div class=\"mb-16 text-center\" style=\"opacity:0;transform:translateY(25px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Our Core Values</span><h2 class=\"mt-5 text-5xl font-bold text-[#D62828]\">What Drives Us Every Day</h2><p class=\"mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600\">Our values guide every decision we make, every structure we build, and every relationship we create with our clients.</p></div><div class=\"grid gap-8 md:grid-cols-2 xl:grid-cols-3\"><div class=\"group rounded-3xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check text-[#D62828]\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Quality</h3><p class=\"mt-5 leading-8 text-slate-600\">We deliver every project with superior craftsmanship, premium materials, and strict quality standards.</p><div class=\"mt-8 h-1 w-20 rounded-full bg-[#0B4EA2] transition-all group-hover:w-full\"></div></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check text-[#D62828]\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Integrity</h3><p class=\"mt-5 leading-8 text-slate-600\">Honesty, transparency, and ethical practices are the foundation of every client relationship.</p><div class=\"mt-8 h-1 w-20 rounded-full bg-[#0B4EA2] transition-all group-hover:w-full\"></div></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lightbulb text-[#D62828]\" aria-hidden=\"true\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"></path><path d=\"M9 18h6\"></path><path d=\"M10 22h4\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Innovation</h3><p class=\"mt-5 leading-8 text-slate-600\">We embrace modern construction technologies and innovative engineering solutions.</p><div class=\"mt-8 h-1 w-20 rounded-full bg-[#0B4EA2] transition-all group-hover:w-full\"></div></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hard-hat text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5\"></path><path d=\"M14 6a6 6 0 0 1 6 6v3\"></path><path d=\"M4 15v-3a6 6 0 0 1 6-6\"></path><rect x=\"2\" y=\"15\" width=\"20\" height=\"4\" rx=\"1\"></rect></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Safety</h3><p class=\"mt-5 leading-8 text-slate-600\">Safety is our highest priority, ensuring secure work environments and compliance with industry standards.</p><div class=\"mt-8 h-1 w-20 rounded-full bg-[#0B4EA2] transition-all group-hover:w-full\"></div></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart-handshake text-[#D62828]\" aria-hidden=\"true\"><path d=\"M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Customer Satisfaction</h3><p class=\"mt-5 leading-8 text-slate-600\">Understanding client requirements and exceeding expectations is our ultimate goal.</p><div class=\"mt-8 h-1 w-20 rounded-full bg-[#0B4EA2] transition-all group-hover:w-full\"></div></div><div class=\"group rounded-3xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10 transition group-hover:bg-[#D62828]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock3 lucide-clock-3 text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6h4\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Timely Delivery</h3><p class=\"mt-5 leading-8 text-slate-600\">Efficient planning and execution help us complete projects on schedule without compromising quality.</p><div class=\"mt-8 h-1 w-20 rounded-full bg-[#0B4EA2] transition-all group-hover:w-full\"></div></div></div></div></section><section class=\"bg-white py-24\"><div class=\"mx-auto max-w-6xl px-6\"><div class=\"mb-20 text-center\" style=\"opacity:0;transform:translateY(25px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Our Journey</span><h2 class=\"mt-5 text-5xl font-bold text-[#D62828]\">Company Timeline</h2><p class=\"mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600\">Every milestone reflects our dedication to engineering excellence, innovation, and delivering successful construction projects.</p></div><div class=\"relative\"><div class=\"absolute left-6 top-0 h-full w-1 bg-[#0B4EA2]/20 md:left-1/2 md:-translate-x-1/2\"></div><div class=\"space-y-16\"><div class=\"relative flex flex-col md:flex-row md:justify-start\" style=\"opacity:0;transform:translateX(-60px)\"><div class=\"absolute left-6 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#D62828] text-white shadow-xl md:left-1/2 md:-translate-x-1/2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg></div><div class=\"ml-24 w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-lg md:ml-0 md:w-[45%] md:mr-auto\"><span class=\"rounded-full bg-[#0B4EA2]/10 px-4 py-2 text-sm font-bold text-[#0B4EA2]\">1998</span><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">MBS GROUPS History</h3><p class=\"mt-4 leading-8 text-slate-600\">MBS Groups has been a trusted name in the steel industry since 1998. Founded by Mr. Byre Gowda with his passion for precision steel solutions has steadily evolved into a benchmark for quality and reliability in civil construction.</p></div></div><div class=\"relative flex flex-col md:flex-row md:justify-end\" style=\"opacity:0;transform:translateX(60px)\"><div class=\"absolute left-6 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#D62828] text-white shadow-xl md:left-1/2 md:-translate-x-1/2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-warehouse\" aria-hidden=\"true\"><path d=\"M18 21V10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v11\"></path><path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 1.132-1.803l7.95-3.974a2 2 0 0 1 1.837 0l7.948 3.974A2 2 0 0 1 22 8z\"></path><path d=\"M6 13h12\"></path><path d=\"M6 17h12\"></path></svg></div><div class=\"ml-24 w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-lg md:ml-0 md:w-[45%] md:ml-auto\"><span class=\"rounded-full bg-[#0B4EA2]/10 px-4 py-2 text-sm font-bold text-[#0B4EA2]\">2010</span><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">MBS Constructions Founded</h3><p class=\"mt-4 leading-8 text-slate-600\">In 2010, Mr. Manjunath H.B., the son of Mr. Byre Gowda, joined the business, bringing a new wave of energy and strategic vision.</p></div></div><div class=\"relative flex flex-col md:flex-row md:justify-start\" style=\"opacity:0;transform:translateX(-60px)\"><div class=\"absolute left-6 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#D62828] text-white shadow-xl md:left-1/2 md:-translate-x-1/2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-factory\" aria-hidden=\"true\"><path d=\"M12 16h.01\"></path><path d=\"M16 16h.01\"></path><path d=\"M3 19a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5a.5.5 0 0 0-.769-.422l-4.462 2.844A.5.5 0 0 1 15 10.5v-2a.5.5 0 0 0-.769-.422L9.77 10.922A.5.5 0 0 1 9 10.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z\"></path><path d=\"M8 16h.01\"></path></svg></div><div class=\"ml-24 w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-lg md:ml-0 md:w-[45%] md:mr-auto\"><span class=\"rounded-full bg-[#0B4EA2]/10 px-4 py-2 text-sm font-bold text-[#0B4EA2]\">2015</span><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">PEB &amp; Roofing Division Expansion</h3><p class=\"mt-4 leading-8 text-slate-600\">MBS Roofing has become a leading name in customized PEB solutions, completing over 10 lakh sq. ft. of godown space — including 4 lakh sq. ft. of self-owned infrastructure.</p></div></div><div class=\"relative flex flex-col md:flex-row md:justify-end\" style=\"opacity:0;transform:translateX(60px)\"><div class=\"absolute left-6 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#D62828] text-white shadow-xl md:left-1/2 md:-translate-x-1/2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><div class=\"ml-24 w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-lg md:ml-0 md:w-[45%] md:ml-auto\"><span class=\"rounded-full bg-[#0B4EA2]/10 px-4 py-2 text-sm font-bold text-[#0B4EA2]\">2021</span><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">100+ Projects Completed</h3><p class=\"mt-4 leading-8 text-slate-600\">Reached the milestone of delivering over 100+ successful industrial and commercial construction projects.</p></div></div><div class=\"relative flex flex-col md:flex-row md:justify-start\" style=\"opacity:0;transform:translateX(-60px)\"><div class=\"absolute left-6 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#D62828] text-white shadow-xl md:left-1/2 md:-translate-x-1/2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hammer\" aria-hidden=\"true\"><path d=\"m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9\"></path><path d=\"m18 15 4-4\"></path><path d=\"m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5\"></path></svg></div><div class=\"ml-24 w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-lg md:ml-0 md:w-[45%] md:mr-auto\"><span class=\"rounded-full bg-[#0B4EA2]/10 px-4 py-2 text-sm font-bold text-[#0B4EA2]\">2023</span><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Turnkey Project Solutions</h3><p class=\"mt-4 leading-8 text-slate-600\">Introduced complete turnkey construction services from design to project handover.</p></div></div><div class=\"relative flex flex-col md:flex-row md:justify-end\" style=\"opacity:0;transform:translateX(60px)\"><div class=\"absolute left-6 z-20 flex h-14 w-14 items-center justify-center rounded-full bg-[#D62828] text-white shadow-xl md:left-1/2 md:-translate-x-1/2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pinned\" aria-hidden=\"true\"><path d=\"M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0\"></path><circle cx=\"12\" cy=\"8\" r=\"2\"></circle><path d=\"M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-3.712\"></path></svg></div><div class=\"ml-24 w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-lg md:ml-0 md:w-[45%] md:ml-auto\"><span class=\"rounded-full bg-[#0B4EA2]/10 px-4 py-2 text-sm font-bold text-[#0B4EA2]\">2026</span><h3 class=\"mt-6 text-2xl font-bold text-[#D62828]\">Growing Across Karnataka</h3><p class=\"mt-4 leading-8 text-slate-600\">Continuing to deliver innovative construction solutions for industries throughout Karnataka.</p></div></div></div></div></div></section><section class=\"bg-slate-50 py-24\"><div class=\"mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-2\"><div class=\"relative\" style=\"opacity:0;transform:translateX(-60px)\"><div class=\"overflow-hidden rounded-[32px] shadow-2xl\"><img alt=\"Why Choose MBS Construction\" loading=\"lazy\" width=\"700\" height=\"750\" decoding=\"async\" data-nimg=\"1\" class=\"h-[720px] w-full object-cover transition duration-700 hover:scale-105\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Fabout%2Fwhy-choose-mbs.png&amp;w=750&amp;q=75 1x, /_next/image?url=%2Fimages%2Fabout%2Fwhy-choose-mbs.png&amp;w=1920&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Fabout%2Fwhy-choose-mbs.png&amp;w=1920&amp;q=75\"/></div><div class=\"absolute -bottom-8 left-8 rounded-3xl bg-[#D62828] p-8 text-white shadow-2xl\"><h3 class=\"text-4xl font-bold\">250+</h3><p class=\"mt-2 uppercase tracking-widest text-sm\">Projects Delivered</p></div></div><div style=\"opacity:0;transform:translateX(60px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Why Choose Us</span><h2 class=\"mt-5 text-5xl font-bold leading-tight text-[#D62828]\">Building Trust Through<br/>Engineering Excellence</h2><p class=\"mt-8 text-lg leading-8 text-slate-600\">MBS Construction combines technical expertise, modern construction practices, and a customer-first approach to deliver durable, cost-effective, and high-quality infrastructure solutions across Karnataka.</p><div class=\"mt-12 grid gap-6 sm:grid-cols-2\"><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award text-[#D62828]\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Proven Experience</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Over a decade of delivering successful industrial and commercial construction projects.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-building2 lucide-building-2 text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 12h4\"></path><path d=\"M10 8h4\"></path><path d=\"M14 21v-3a2 2 0 0 0-4 0v3\"></path><path d=\"M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2\"></path><path d=\"M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16\"></path></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Complete Turnkey Solutions</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">From planning and design to execution and final handover under one roof.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock3 lucide-clock-3 text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6h4\"></path></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">On-Time Delivery</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Efficient project management ensures timely completion without compromising quality.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check text-[#D62828]\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Premium Quality</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">We use high-grade materials and follow strict quality control standards.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hard-hat text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5\"></path><path d=\"M14 6a6 6 0 0 1 6 6v3\"></path><path d=\"M4 15v-3a6 6 0 0 1 6-6\"></path><rect x=\"2\" y=\"15\" width=\"20\" height=\"4\" rx=\"1\"></rect></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Safety First</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Every project follows industry-standard safety practices for workers and clients.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench text-[#D62828]\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Modern Technology</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Advanced equipment and engineering methods for durable and efficient structures.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users text-[#D62828]\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Experienced Team</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Dedicated architects, engineers, supervisors, and skilled technicians.</p></div></div><div class=\"flex gap-4 rounded-2xl bg-white p-5 shadow-md transition hover:-translate-y-2 hover:shadow-xl\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"flex h-14 w-14 items-center justify-center rounded-xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check text-[#D62828]\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><h3 class=\"font-bold text-[#0B4EA2]\">Customer Satisfaction</h3><p class=\"mt-2 text-sm leading-6 text-slate-600\">Long-term relationships built on trust, transparency, and excellent service.</p></div></div></div></div></div></section><section class=\"bg-slate-50 py-24\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"mx-auto mb-16 max-w-3xl text-center\" style=\"opacity:0;transform:translateY(40px)\"><span class=\"rounded-full bg-[#D62828]/10 px-5 py-2 text-sm font-semibold uppercase tracking-[0.2em] text-[#D62828]\">Industries We Serve</span><h2 class=\"mt-6 text-5xl font-bold text-[#D62828]\">Building Across Diverse Industries</h2><p class=\"mt-6 text-lg leading-8 text-[#0B4EA2]\">From industrial warehouses to commercial buildings, MBS Construction delivers reliable, high-quality infrastructure tailored to every industry&#x27;s unique requirements.</p></div><div class=\"grid gap-8 md:grid-cols-2 xl:grid-cols-3\"><div class=\"group relative overflow-hidden rounded-3xl\"><div class=\"relative h-80\"><img alt=\"Industrial Warehouses\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Findustries%2Fwarehouse.png&amp;w=2048&amp;q=75 2048w, 