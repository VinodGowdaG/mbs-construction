stries%2Flogistics.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Findustries%2Flogistics.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Findustries%2Flogistics.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Findustries%2Flogistics.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent\"></div><div class=\"absolute bottom-0 left-0 right-0 p-8\"><h3 class=\"text-2xl font-bold text-white\">Logistics &amp; Distribution</h3><div class=\"mt-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#D62828] transition group-hover:rotate-45\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-white\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div></div></div><div class=\"group relative overflow-hidden rounded-3xl\"><div class=\"relative h-80\"><img alt=\"Agricultural Buildings\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Findustries%2Fagriculture.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent\"></div><div class=\"absolute bottom-0 left-0 right-0 p-8\"><h3 class=\"text-2xl font-bold text-white\">Agricultural Buildings</h3><div class=\"mt-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#D62828] transition group-hover:rotate-45\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-white\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div></div></div><div class=\"group relative overflow-hidden rounded-3xl\"><div class=\"relative h-80\"><img alt=\"Infrastructure Projects\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition duration-700 group-hover:scale-110\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Findustries%2Finfrastructure.png&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent\"></div><div class=\"absolute bottom-0 left-0 right-0 p-8\"><h3 class=\"text-2xl font-bold text-white\">Infrastructure Projects</h3><div class=\"mt-5 flex h-12 w-12 items-center justify-center rounded-full bg-[#D62828] transition group-hover:rotate-45\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right text-white\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></div></div></div></div></div></div></section><section class=\"bg-white py-24\"><div class=\"mx-auto max-w-7xl px-6\"><div class=\"mb-16 text-center\" style=\"opacity:0;transform:translateY(25px)\"><span class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#0B4EA2]\">Our Commitment</span><h2 class=\"mt-5 text-5xl font-bold text-[#D62828]\">Quality &amp; Excellence</h2><p class=\"mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-600\">We continuously improve our processes to deliver reliable, high-quality, and safe construction solutions for every client.</p></div><div class=\"grid gap-8 md:grid-cols-2 xl:grid-cols-3\"><div class=\"rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg transition hover:shadow-xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-badge-check text-[#D62828]\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Quality Assurance</h3><p class=\"mt-5 leading-8 text-slate-600\">Every project follows strict quality control standards using premium materials and proven construction practices.</p></div><div class=\"rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg transition hover:shadow-xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check text-[#D62828]\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Safety Standards</h3><p class=\"mt-5 leading-8 text-slate-600\">We prioritize worker safety and maintain industry-standard safety protocols on every project.</p></div><div class=\"rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg transition hover:shadow-xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-hard-hat text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5\"></path><path d=\"M14 6a6 6 0 0 1 6 6v3\"></path><path d=\"M4 15v-3a6 6 0 0 1 6-6\"></path><rect x=\"2\" y=\"15\" width=\"20\" height=\"4\" rx=\"1\"></rect></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Experienced Engineers</h3><p class=\"mt-5 leading-8 text-slate-600\">Our qualified engineers and supervisors ensure precise planning, execution, and project management.</p></div><div class=\"rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg transition hover:shadow-xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wrench text-[#D62828]\" aria-hidden=\"true\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Modern Equipment</h3><p class=\"mt-5 leading-8 text-slate-600\">Advanced machinery and construction technologies help us deliver efficient and durable structures.</p></div><div class=\"rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg transition hover:shadow-xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trophy text-[#D62828]\" aria-hidden=\"true\"><path d=\"M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978\"></path><path d=\"M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978\"></path><path d=\"M18 9h1.5a1 1 0 0 0 0-5H18\"></path><path d=\"M4 22h16\"></path><path d=\"M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z\"></path><path d=\"M6 9H4.5a1 1 0 0 1 0-5H6\"></path></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Engineering Excellence</h3><p class=\"mt-5 leading-8 text-slate-600\">Our focus on innovation and technical expertise ensures long-lasting industrial infrastructure.</p></div><div class=\"rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg transition hover:shadow-xl\" style=\"opacity:0;transform:translateY(40px)\"><div class=\"flex h-16 w-16 items-center justify-center rounded-2xl bg-[#0B4EA2]/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users text-[#D62828]\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"mt-8 text-2xl font-bold text-[#D62828]\">Customer Satisfaction</h3><p class=\"mt-5 leading-8 text-slate-600\">Transparent communication, timely delivery, and reliable support have earned the trust of our clients.</p></div></div></div></section><section class=\"relative overflow-hidden py-24\"><img alt=\"MBS Construction\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fabout%2Fabout-cta.png&amp;w=640&amp;q=75 640w